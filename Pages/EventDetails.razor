@page "/events/{Id:int}"
@using EventEase.Models
@using EventEase.Services
@inject EventService EventService
@inject NavigationManager NavManager

<PageTitle>Event Details - EventEase</PageTitle>

@if (currentEvent == null)
{
    <div class="alert alert-danger mt-3">
        <h4>Event Not Found</h4>
        <p>The requested event ID does not exist or has been removed.</p>
        <button class="btn btn-outline-danger" @onclick="GoBack">Back to Events</button>
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2>@currentEvent.Name</h2>
            <p class="text-muted mb-1"><strong>Date:</strong> @currentEvent.Date.ToString("D")</p>
            <p class="text-muted"><strong>Location:</strong> @currentEvent.Location</p>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">Back to Events</button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card p-3">
                <h4>Event Registration</h4>
                <EditForm Model="@registration" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <InputText class="form-control" @bind-Value="registration.UserName" placeholder="John Doe" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <InputText class="form-control" @bind-Value="registration.UserEmail" placeholder="john@example.com" />
                    </div>

                    <button type="submit" class="btn btn-success">Complete Registration</button>
                </EditForm>

                @if (registrationSuccess)
                {
                    <div class="alert alert-success mt-3">
                        Registration successful! Your session is now active.
                    </div>
                }
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card p-3">
                <h4>Attendance Tracker (@currentEvent.Attendees.Count)</h4>
                @if (currentEvent.Attendees.Count == 0)
                {
                    <p class="text-muted">No attendees registered for this event yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var attendee in currentEvent.Attendees)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>@attendee.UserName</strong></span>
                                <span class="text-muted small">@attendee.UserEmail</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventModel? currentEvent;
    private RegistrationModel registration = new();
    private bool registrationSuccess = false;

    protected override void OnInitialized()
    {
        currentEvent = EventService.GetEventById(Id);
    }

    private void HandleValidSubmit()
    {
        if (currentEvent != null)
        {
            EventService.RegisterUser(currentEvent.Id, registration);
            registration = new();
            registrationSuccess = true;
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/events");
    }
}
