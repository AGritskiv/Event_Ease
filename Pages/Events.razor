@page "/events"
@using EventEase.Services
@using EventEase.Components
@inject EventService EventService

<PageTitle>Upcoming Events - EventEase</PageTitle>

<h2 class="mb-3">Upcoming Events</h2>

@if (!string.IsNullOrEmpty(EventService.CurrentUser))
{
    <div class="alert alert-success">
        Active Session: Welcome back, <strong>@EventService.CurrentUser</strong>!
    </div>
}

<div class="row">
    @foreach (var ev in EventService.Events)
    {
        <div class="col-md-6 col-lg-4" @key="ev.Id">
            <EventCard Event="ev" />
        </div>
    }
</div>
