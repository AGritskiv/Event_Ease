@using EventEase.Models
@inject NavigationManager NavManager

<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <h5 class="card-title text-primary">@Event.Name</h5>
        <p class="card-text mb-1"><strong>Date:</strong> @Event.Date.ToString("MMMM dd, yyyy")</p>
        <p class="card-text mb-1"><strong>Location:</strong> @Event.Location</p>
        <p class="card-text">
            <span class="badge bg-secondary">Attendees: @Event.Attendees.Count</span>
        </p>

        <div class="mb-3">
            <label class="form-label small text-muted">Quick Edit Event Name (Two-Way Binding):</label>
            <input class="form-control form-control-sm" @bind="Event.Name" @bind:event="oninput" />
        </div>

        <button class="btn btn-primary btn-sm" @onclick="NavigateToDetails">
            View Details & Register
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventModel Event { get; set; } = new();

    private void NavigateToDetails()
    {
        NavManager.NavigateTo($"/events/{Event.Id}");
    }
}
